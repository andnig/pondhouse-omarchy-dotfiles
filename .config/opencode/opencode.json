{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "update": "notify",
  "lsp": {
    "csharp": {
      "disabled": false,
      "command": ["csharp-ls"],
      "extensions": [".cs"],
      "env": {
        "DOTNET_ROOT": "$HOME/.local/share/mise/installs/dotnet/10"
      }
    }
  },
  "plugins": ["opencode-claude-auth-v2@latest"],
  "mcp": {
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": false
    },
    // "playwriter": {
    //   "type": "local",
    //   "command": [
    //     "npx",
    //     "-y",
    //     "playwriter@latest"
    //   ],
    //   "enabled": false
    // },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "read": "allow",
    "edit": {
      "/**": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "*": "allow"
    }
  },
  "websearch": {
    "provider": "random"
  }
}
